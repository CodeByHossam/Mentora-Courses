<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Mismatch - Mentora</title>
    <link rel="stylesheet" href="/style.css" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>
  <body>
    <div class="page-wrapper">
      <div class="message-card message-error fade-in">
        <div class="icon icon-error">🔒</div>

        <h1 class="brand-title">Mentora</h1>

        <h2 class="page-title text-error">Password Mismatch</h2>

        <p class="subtitle">
          The passwords you entered don't match. Please make sure both password
          fields contain the exact same password. 🔐
        </p>

        <div style="margin: 2rem 0">
          <div
            style="
              background: var(--error-50);
              padding: 1.5rem;
              border-radius: var(--radius-lg);
              margin-bottom: 2rem;
            "
          >
            <h3
              style="
                color: var(--error-700);
                margin-bottom: 1rem;
                font-size: 1.125rem;
              "
            >
              💡 Password Tips
            </h3>
            <ul
              style="
                text-align: left;
                color: var(--error-600);
                line-height: 1.8;
              "
            >
              <li>🔤 Use at least 8 characters</li>
              <li>🔠 Include uppercase and lowercase letters</li>
              <li>🔢 Add numbers and special characters</li>
              <li>👀 Double-check both fields match exactly</li>
            </ul>
          </div>
        </div>

        <div
          style="
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
          "
        >
          <button onclick="history.back()" class="btn btn-primary">
            ← Try Again
          </button>
          <a
            href="<%= process.env.CLIENT_URL %>/forgot-password"
            class="btn btn-success"
          >
            🔄 Request New Link
          </a>
        </div>

        <div
          style="
            margin-top: 2rem;
            padding-top: 2rem;
            border-top: 1px solid var(--gray-200);
          "
        >
          <p style="font-size: 0.875rem; color: var(--gray-500)">
            Need help? Contact our support team at
            <a href="mailto:support@mentora.com" class="link"
              >support@mentora.com</a
            >
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
