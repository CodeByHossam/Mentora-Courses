<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Reset Successful</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <div class="page-wrapper">
      <div class="form-container fade-in" style="text-align: center">
        <div
          class="icon"
          style="font-size: 3rem; margin-bottom: var(--space-4)"
        >
          ✅
        </div>
        <h1 class="form-title">Password Reset Successful</h1>
        <p style="color: var(--gray-600); margin-bottom: var(--space-6)">
          Your password has been updated. You can now log in with your new
          password.
        </p>
        <a href="<%= process.env.CLIENT_URL %>" class="btn btn-success"
          >Go to Home</a
        >
      </div>
    </div>
  </body>
</html>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Reset Successful - Mentora</title>
    <link rel="stylesheet" href="/style.css" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>
  <body>
    <div class="page-wrapper">
      <div class="message-card message-success fade-in">
        <div class="icon icon-success">🔐</div>

        <h1 class="brand-title">Mentora</h1>

        <h2 class="page-title text-success">Password Reset Successful!</h2>

        <p class="subtitle">
          ✅ Your password has been successfully updated. You can now log in
          with your new password.
        </p>

        <div style="margin: 2rem 0">
          <div
            style="
              background: var(--primary-50);
              padding: 1.5rem;
              border-radius: var(--radius-lg);
              margin-bottom: 2rem;
            "
          >
            <h3
              style="
                color: var(--primary-700);
                margin-bottom: 1rem;
                font-size: 1.125rem;
              "
            >
              🛡️ Security Tips
            </h3>
            <ul
              style="
                text-align: left;
                color: var(--primary-600);
                line-height: 1.8;
              "
            >
              <li>🔒 Use a strong, unique password</li>
              <li>📱 Enable two-factor authentication if available</li>
              <li>🚫 Don't share your password with anyone</li>
              <li>🔄 Update your password regularly</li>
            </ul>
          </div>
        </div>

        <div
          style="
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
          "
        >
          <a href="<%= process.env.CLIENT_URL %>/login" class="btn btn-primary">
            🔐 Login Now
          </a>
          <a href="<%= process.env.CLIENT_URL %>" class="btn btn-success">
            🏠 Go to Homepage
          </a>
        </div>

        <div
          style="
            margin-top: 2rem;
            padding-top: 2rem;
            border-top: 1px solid var(--gray-200);
          "
        >
          <p style="font-size: 0.875rem; color: var(--gray-500)">
            If you didn't request this password reset, please contact us
            immediately at
            <a href="mailto:security@mentora.com" class="link"
              >security@mentora.com</a
            >
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
